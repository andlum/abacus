# Settings for docker-compose.selfhost.yml. Copy to .env and fill in.
# See docs/self-hosting.md.

# The database's password. Letters and digits only, because it goes into a
# connection URL: `openssl rand -hex 24`. Changing it after the first start
# does not change the database; see the guide.
POSTGRES_PASSWORD=

# Signs session cookies: `openssl rand -base64 32`. Changing it signs
# everyone out.
BETTER_AUTH_SECRET=

# Where people reach the app, with no trailing slash. Links in emails point
# here, and sign-in only works from this address.
BETTER_AUTH_URL=https://abacus.example.com

# The SMTP server that sends sign-in and invitation emails:
# smtp://user:pass@host:587 or smtps://user:pass@host:465.
SMTP_URL=
MAIL_FROM="Abacus <abacus@example.com>"

# Who may sign up without an invitation. Empty: only the first person, who
# then sets up the group at /setup. 1: anyone with a confirmed email.
ABACUS_OPEN_SIGNUP=

# Daily ceilings per account on creating groups and sending invite emails.
# Empty uses the defaults (5, 10, 1, 20); docs/setup.md says what each is.
ABACUS_MAX_GROUPS_PER_DAY=
ABACUS_MAX_INVITE_EMAILS_PER_DAY=
ABACUS_MAX_INVITE_EMAILS_PER_ADDRESS=
ABACUS_MAX_OPEN_INVITES=

# The header your reverse proxy puts the visitor's address in, which the
# sign-in rate limit counts by: x-real-ip for the nginx example in the guide.
# Leave empty only if nothing sits in front of the app.
ABACUS_CLIENT_IP_HEADER=

# Recurring costs post on their date from a job inside the app, every hour.
# 0 switches it off; they then post when someone opens the app.
ABACUS_DAILY_JOB=

# Optional: connecting a bank through Plaid, with your own Plaid keys. Leave
# all four empty to turn it off. PLAID_ENV is sandbox (the default) or
# production. The encryption key seals Plaid's tokens in the database:
# 32 random bytes in base64, from `openssl rand -base64 32`. Keep it safe;
# without it, connected banks must be connected again.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
ABACUS_ENCRYPTION_KEY=

# The app listens on this address and port of the host. The default is
# reachable only from this machine, for a reverse proxy on it to forward to.
ABACUS_BIND=127.0.0.1
ABACUS_PORT=3000
