{
  "name": "@abacus/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:live": "sh scripts/check-live.sh",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:counts": "node --env-file-if-exists=.env.local scripts/count-rows.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:provision": "node --env-file-if-exists=.env.local scripts/provision-household.ts"
  },
  "dependencies": {
    "@abacus/core": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "1.7.14",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.58.0",
    "next": "^16.4.6",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
