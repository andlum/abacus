# Copy to .env.local (gitignored) and fill in.

# Local: the docker compose database. Production: your database's connection string
# (the pooled one, if your provider offers a pooler).
DATABASE_URL=postgres://abacus:abacus@localhost:5432/abacus
# Production only: the direct (non-pooled) string, if DATABASE_URL is pooled. Migrations use it when set.
DATABASE_URL_UNPOOLED=

# Sign-in (Better Auth, runs inside the app). The secret signs session
# cookies: `openssl rand -base64 32`. The URL is where people reach the app;
# links in emails point there.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Where sign-in emails (confirm address, reset password) go out. Any SMTP
# server: smtp://user:pass@host:587 or smtps://user:pass@host:465. Leave
# empty locally and the app prints each email to the server log instead.
# A production build refuses to start without it.
SMTP_URL=
MAIL_FROM="Abacus <abacus@example.com>"

# Who may sign up without an invitation. Empty: only the first person, on an
# empty database, who then sets up the household at /setup. 1: anyone with a
# confirmed email may create their own household (a hosted service).
ABACUS_OPEN_SIGNUP=

# Optional, and only read by `pnpm db:provision`, which creates the household
# from these instead of the /setup form.
HOUSEHOLD_NAME=
MEMBER_1_NAME=
MEMBER_1_EMAIL=
MEMBER_2_NAME=
MEMBER_2_EMAIL=
# A timezone name such as America/New_York. Decides which day "today" is.
HOUSEHOLD_TIMEZONE=

# Header the sign-in rate limit reads the client address from: `fly-client-ip`
# on Fly, `x-real-ip` behind nginx. Unset, no header is trusted and every
# client shares one limit (a client-set header would let them dodge it).
ABACUS_CLIENT_IP_HEADER=

# Local only: set to 1 to sign in at /dev-sign-in by picking a member, with no
# password or email. Ignored when NODE_ENV is production.
ABACUS_E2E=
