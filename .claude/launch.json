{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "abacus-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@abacus/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "abacus-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ABACUS_E2E=1",
        "DATABASE_URL=postgres://abacus:abacus@localhost:5432/abacus_e2e",
        "pnpm",
        "--filter",
        "@abacus/web",
        "exec",
        "next",
        "dev",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "abacus-env-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "set -a; . ./.env.local; set +a; exec pnpm --filter @abacus/web exec next dev -p 3200"
      ],
      "port": 3200
    },
    {
      "name": "abacus-setup-try",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ABACUS_E2E=",
        "SMTP_URL=",
        "ABACUS_OPEN_SIGNUP=",
        "BETTER_AUTH_URL=http://localhost:3300",
        "BETTER_AUTH_SECRET=local-only-secret-for-trying-setup-0000",
        "DATABASE_URL=postgres://abacus:abacus@localhost:5432/abacus_setup_try",
        "pnpm",
        "--filter",
        "@abacus/web",
        "exec",
        "next",
        "dev",
        "-p",
        "3300"
      ],
      "port": 3300
    }
  ]
}
